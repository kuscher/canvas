+void add_appearance_menu(QMainWindow& window) {
+  auto* bar = window.menuBar();
+  auto* menu = new QMenu(bar);
+  menu->setObjectName(QStringLiteral("canvasAppearanceMenu"));
+  auto* group = new QActionGroup(menu);
+  struct Choice {
+    const char* label;
+    ColorSchemePreference preference;
+  };
+  for (const auto& choice : {Choice{"Auto (follow the system)", ColorSchemePreference::FollowSystem},
+                             Choice{"Light", ColorSchemePreference::Light},
+                             Choice{"Dark", ColorSchemePreference::Dark}}) {
+    auto* action = menu->addAction(QString::fromLatin1(choice.label));
+    action->setCheckable(true);
+    action->setData(static_cast<int>(choice.preference));
+    group->addAction(action);
+    QObject::connect(action, &QAction::triggered, menu, [preference = choice.preference] {
+      ThemeManager::instance().set_preference(preference, /*persist=*/true);
+    });
+  }
+  auto* menu_action = bar->addMenu(menu);
+  menu_action->setObjectName(QStringLiteral("canvasAppearanceMenuAction"));
+  menu_action->setToolTip(QStringLiteral("Appearance: Auto, Light or Dark"));
+  const auto refresh = [bar, group, menu_action] {
+    const auto current = ThemeManager::instance().preference();
+    for (auto* action : group->actions()) {
+      action->setChecked(action->data().toInt() == static_cast<int>(current));
+    }
+    menu_action->setIcon(appearance_icon(current, theme().text_bright, bar->devicePixelRatio()));
+  };
+  refresh();
+  QObject::connect(menu, &QMenu::aboutToShow, menu, refresh);
+  QObject::connect(group, &QActionGroup::triggered, menu, [refresh] { QTimer::singleShot(0, refresh); });
+  QObject::connect(&ThemeManager::instance(), &ThemeManager::color_scheme_changed, menu,
+                   [refresh] { QTimer::singleShot(0, refresh); });
+}
