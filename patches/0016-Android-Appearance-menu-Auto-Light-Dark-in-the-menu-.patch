+QIcon appearance_icon(ColorSchemePreference preference, const QColor& color, double ratio) {
+  const int size = 20;
+  QPixmap pixmap(QSize(size, size) * ratio);
+  pixmap.setDevicePixelRatio(ratio);
+  pixmap.fill(Qt::transparent);
+  QPainter painter(&pixmap);
+  painter.setRenderHint(QPainter::Antialiasing);
+  painter.setPen(QPen(color, 1.6, Qt::SolidLine, Qt::RoundCap));
+  const QPointF center(size / 2.0, size / 2.0);
+  switch (preference) {
+    case ColorSchemePreference::Light: {
+      painter.setBrush(color);
+      painter.drawEllipse(center, 3.6, 3.6);
+      for (int i = 0; i < 8; ++i) {
+        const double angle = i * M_PI / 4.0;
+        painter.drawLine(center + QPointF(std::cos(angle), std::sin(angle)) * 6.2,
+                         center + QPointF(std::cos(angle), std::sin(angle)) * 8.4);
+      }
+      break;
+    }
+    case ColorSchemePreference::Dark: {
+      QPainterPath moon;
+      moon.addEllipse(center, 7.0, 7.0);
+      QPainterPath bite;
+      bite.addEllipse(center + QPointF(3.8, -3.0), 5.8, 5.8);
+      painter.setPen(Qt::NoPen);
+      painter.setBrush(color);
+      painter.drawPath(moon.subtracted(bite));
+      break;
+    }
+    case ColorSchemePreference::FollowSystem: {
+      painter.setBrush(Qt::NoBrush);
+      painter.drawEllipse(center, 7.0, 7.0);
+      QPainterPath half;
+      half.moveTo(center + QPointF(0, -7.0));
+      half.arcTo(QRectF(center - QPointF(7.0, 7.0), QSizeF(14.0, 14.0)), 90, 180);
+      half.closeSubpath();
+      painter.setPen(Qt::NoPen);
+      painter.setBrush(color);
+      painter.drawPath(half);
+      break;
+    }
+  }
+  return QIcon(pixmap);
+}
+
+}  // namespace
