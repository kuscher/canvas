From: Alexander <4418484+kuscher@users.noreply.github.com>
Date: Tue, 29 Sep 2026 06:54:57 +0000
Subject: [PATCH 06/19] Android: print through Android's print dialog

Qt has no printer drivers on Android, so File > Print writes the page as a
PDF with Patchy's own placement (actual size, or fit when that overflows)
on the locale's paper, turned to the document's orientation, and hands it
to Android's print dialog, which picks the printer, paper and copies or
saves a PDF. Page Setup stays hidden.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ui/android_window.cpp            | 36 ++++++++++++++++++++++++++++
 src/ui/android_window.hpp            | 12 ++++++++++
 src/ui/main_window_actions_menus.cpp |  6 ++---
 src/ui/print_dialog.cpp              | 10 ++++++++
 4 files changed, 61 insertions(+), 3 deletions(-)

diff --git a/src/ui/android_window.cpp b/src/ui/android_window.cpp
index 3479a76..d91aa2e 100644
--- a/src/ui/android_window.cpp
+++ b/src/ui/android_window.cpp
@@ -4,7 +4,10 @@
 #include "ui/theme_palette.hpp"
 
 #include <QCoreApplication>
+#include <QDir>
 #include <QJniObject>
+#include <QLocale>
+#include <QStandardPaths>
 
 namespace patchy::ui::android_window {
 namespace {
@@ -18,6 +21,39 @@ void push_caption_color(ColorScheme scheme) {
 
 }  // namespace
 
+bool print_as_pdf(const Document& document, const PrintSettings& settings, const QPageLayout& page_layout,
+                  const QString& title) {
+  // Page Setup is hidden on Android, so pick the sheet here.
+  const auto sheet = QLocale().measurementSystem() == QLocale::MetricSystem ? QPageSize(QPageSize::A4)
+                                                                             : QPageSize(QPageSize::Letter);
+  const auto orientation =
+      document.width() > document.height() ? QPageLayout::Landscape : QPageLayout::Portrait;
+  auto layout = page_layout_with_size(page_layout, sheet, orientation);
+  // Refit for the new sheet: fit when actual size would overflow it.
+  auto page_settings = settings;
+  if (page_settings.scale_mode != PrintScaleMode::FitToPage) {
+    auto actual = page_settings;
+    actual.scale_mode = PrintScaleMode::ActualSize;
+    const auto placement = calculate_print_placement(document, actual, layout);
+    const auto printable = layout.paintRect(QPageLayout::Point);
+    if (placement.target_rect_points.width() > printable.width() + 0.5 ||
+        placement.target_rect_points.height() > printable.height() + 0.5) {
+      page_settings.scale_mode = PrintScaleMode::FitToPage;
+    }
+  }
+  const auto folder = QStandardPaths::writableLocation(QStandardPaths::CacheLocation) + QStringLiteral("/print");
+  QDir().mkpath(folder);
+  const auto path = folder + QLatin1Char('/') + default_print_pdf_filename(title);
+  if (!write_print_pdf(path, document, page_settings, layout, title)) {
+    return false;
+  }
+  QJniObject::callStaticMethod<void>("io/github/kuscher/canvas/CanvasPrint", "printPdf",
+                                     "(Ljava/lang/String;Ljava/lang/String;)V",
+                                     QJniObject::fromString(path).object<jstring>(),
+                                     QJniObject::fromString(title).object<jstring>());
+  return true;
+}
+
 void follow_theme_in_caption_bar() {
   auto& themes = ThemeManager::instance();
   push_caption_color(themes.resolved_scheme());
