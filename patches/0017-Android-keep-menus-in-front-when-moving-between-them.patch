+// Popups that are open, in the order they opened, raised again whenever one
+// opens or closes or another window becomes active.
+class PopupStack final : public QObject {
+ public:
+  using QObject::QObject;
+
+ protected:
+  bool eventFilter(QObject* watched, QEvent* event) override {
+    if (!watched->isWidgetType()) {
+      return false;
+    }
+    auto* widget = static_cast<QWidget*>(watched);
+    switch (event->type()) {
+      case QEvent::Show:
+      case QEvent::Hide:
+        if (widget->windowType() == Qt::Popup) {
+          open_.removeAll(widget);
+          if (event->type() == QEvent::Show) {
+            open_.append(widget);
+          }
+          schedule();
+        }
+        break;
+      case QEvent::WindowActivate:
+        if (widget->isWindow() && widget->windowType() != Qt::Popup && QApplication::activePopupWidget()) {
+          schedule();
+        }
+        break;
+      default:
+        break;
+    }
+    return false;
+  }
+
+ private:
+  void schedule() {
+    if (!pending_) {
+      pending_ = true;
+      QTimer::singleShot(0, this, [this] {
+        pending_ = false;
+        raise_open();
+      });
+    }
+  }
+
+  void raise_open() {
+    open_.removeIf([](const QPointer<QWidget>& popup) { return popup.isNull() || !popup->isVisible(); });
+    for (const auto& popup : std::as_const(open_)) {
+      if (auto* handle = popup->windowHandle()) {
+        handle->raise();
+      }
+    }
+  }
+
+  QList<QPointer<QWidget>> open_;
+  bool pending_ = false;
+};
+
