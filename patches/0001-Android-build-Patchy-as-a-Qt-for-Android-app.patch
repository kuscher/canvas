diff --git a/cmake/patchy_android.cmake b/cmake/patchy_android.cmake
new file mode 100644
index 0000000..cbaeeba
--- /dev/null
+++ b/cmake/patchy_android.cmake
@@ -0,0 +1,67 @@
+# The Android app target. Qt builds the app as a shared library
+# (libpatchy_<abi>.so) plus an apk target that androiddeployqt packages.
+#
+# The runtime files the desktop builds stage next to the executable (fonts,
+# translations, bundled scripts) ride along as Qt resources under :/, because
+# an Android app's executable directory is its read-only native-library
+# folder. The web build's metric-compatible fonts come too (Android has no
+# Arial, Times or Calibri), minus the CJK families Android already has.
+#
+# Optional cache variables:
+#   PATCHY_ANDROID_PACKAGE_DIR   AndroidManifest.xml, res/ and src/ (Java) that
+#                                replace Qt's template (QT_ANDROID_PACKAGE_SOURCE_DIR)
+#   PATCHY_ANDROID_VERSION_NAME  versionName (default: the project version)
+#   PATCHY_ANDROID_VERSION_CODE  versionCode (default: 1)
+
+set(PATCHY_ANDROID_PACKAGE_DIR "" CACHE PATH "Android package sources (manifest, res, java)")
+set(PATCHY_ANDROID_VERSION_NAME "${PROJECT_VERSION}" CACHE STRING "Android versionName")
+set(PATCHY_ANDROID_VERSION_CODE "1" CACHE STRING "Android versionCode")
+
+function(patchy_android_resource_files out_var source_dir alias_dir)
+  file(GLOB_RECURSE files RELATIVE "${source_dir}" CONFIGURE_DEPENDS "${source_dir}/*")
+  set(result)
+  foreach(relative IN LISTS files)
+    if(relative MATCHES "^(noto_sans_jp|noto_sans_sc|noto_sans_tc)/")
+      continue()
+    endif()
+    set(file "${source_dir}/${relative}")
+    set_source_files_properties("${file}" PROPERTIES QT_RESOURCE_ALIAS "${alias_dir}/${relative}")
+    list(APPEND result "${file}")
+  endforeach()
+  set(${out_var} ${result} PARENT_SCOPE)
+endfunction()
+
+function(patchy_add_android_app)
+  qt_add_executable(patchy src/app/main.cpp)
+  set_target_properties(patchy PROPERTIES
+    QT_ANDROID_MIN_SDK_VERSION 28
+    QT_ANDROID_TARGET_SDK_VERSION 36
+    QT_ANDROID_VERSION_NAME "${PATCHY_ANDROID_VERSION_NAME}"
+    QT_ANDROID_VERSION_CODE "${PATCHY_ANDROID_VERSION_CODE}"
+  )
+  # Deploy only the plugins the app uses. The QML debug services pull in Qt Quick
+  # (Patchy uses Qt Qml for QJSEngine scripting only, like the web build), and
+  # the app has no network access, so no TLS or network-information backends.
+  qt_import_plugins(patchy EXCLUDE_BY_TYPE qmltooling tls networkinformation)
+  # Nothing to scan for QML imports: Patchy ships no QML.
+  set(empty_qml_root "${CMAKE_BINARY_DIR}/android-empty-qml-root")
+  file(MAKE_DIRECTORY "${empty_qml_root}")
+  set_property(TARGET patchy PROPERTY QT_QML_ROOT_PATH "${empty_qml_root}")
+  if(PATCHY_ANDROID_PACKAGE_DIR)
+    set_property(TARGET patchy PROPERTY QT_ANDROID_PACKAGE_SOURCE_DIR "${PATCHY_ANDROID_PACKAGE_DIR}")
+  endif()
+
+  patchy_android_resource_files(fonts "${PATCHY_BUNDLED_FONTS_DIR}" fonts)
+  patchy_android_resource_files(web_fonts "${PATCHY_BUNDLED_FONTS_WEB_DIR}" fonts)
+  patchy_android_resource_files(scripts "${PROJECT_SOURCE_DIR}/scripts/bundled" scripts)
+  set(translations)
+  foreach(qm IN LISTS PATCHY_QM_FILES PATCHY_QT_BASE_QM_FILES)
+    get_filename_component(name "${qm}" NAME)
+    set_source_files_properties("${qm}" PROPERTIES QT_RESOURCE_ALIAS "translations/${name}" GENERATED TRUE)
+    list(APPEND translations "${qm}")
+  endforeach()
+  qt_add_resources(patchy patchy_android_runtime
+    PREFIX "/"
+    FILES ${fonts} ${web_fonts} ${scripts} ${translations}
+  )
+endfunction()
