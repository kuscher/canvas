+QStringList document_uris_of(const QJniObject& intent) {
+  const auto array = QJniObject::callStaticObjectMethod(kJavaFiles, "documentUris",
+                                                        "(Landroid/content/Intent;)[Ljava/lang/String;",
+                                                        intent.object());
+  QStringList uris;
+  if (!array.isValid()) {
+    return uris;
+  }
+  QJniEnvironment env;
+  const auto strings = static_cast<jobjectArray>(array.object());
+  const auto count = env->GetArrayLength(strings);
+  for (jsize i = 0; i < count; ++i) {
+    const QJniObject item(env->GetObjectArrayElement(strings, i));
+    uris.push_back(item.toString());
+  }
+  return uris;
+}
+
+QStringList import_documents(const QStringList& uris) {
+  QStringList paths;
+  for (const auto& uri : uris) {
+    if (const auto path = import_document(uri); !path.isEmpty()) {
+      paths.push_back(path);
+    } else {
+      show_critical_message(nullptr, QStringLiteral("Open"),
+                            QStringLiteral("Canvas could not read \"%1\".").arg(java_display_name(uri)),
+                            QStringLiteral("androidOpenFailedMessageBox"));
+    }
+  }
+  return paths;
+}
+
+class NewDocumentListener final : public QtAndroidPrivate::NewIntentListener {
+ public:
+  std::function<void(const QStringList&)> open;
+
+  // Runs on the Android UI thread: read the URIs here, copy and open on the GUI thread.
+  bool handleNewIntent(JNIEnv* /*env*/, jobject intent) override {
+    const auto uris = document_uris_of(QJniObject(intent));
+    if (uris.isEmpty() || !open) {
+      return false;
+    }
+    QMetaObject::invokeMethod(
+        qApp, [uris, open = open] { if (const auto paths = import_documents(uris); !paths.isEmpty()) open(paths); },
+        Qt::QueuedConnection);
+    return true;
+  }
+};
+
 QString documents_root() {
   return QStandardPaths::writableLocation(QStandardPaths::AppDataLocation) + QStringLiteral("/documents");
 }
@@ -181,6 +231,29 @@ QString pick_save_file(QWidget* parent, const QString& caption, const QString& i
   return working_copy_for(uri, name);
 }
 
+QStringList take_launch_documents() {
+  static bool taken = false;
+  if (taken) {
+    return {};
+  }
+  taken = true;
+  const QJniObject activity = QtAndroidPrivate::activity();
+  if (!activity.isValid()) {
+    return {};
+  }
+  const auto intent = activity.callObjectMethod("getIntent", "()Landroid/content/Intent;");
+  return intent.isValid() ? import_documents(document_uris_of(intent)) : QStringList();
+}
+
+void watch_new_documents(std::function<void(const QStringList&)> open) {
+  static NewDocumentListener listener;
+  const bool first = !listener.open;
+  listener.open = std::move(open);
+  if (first) {
+    QtAndroidPrivate::registerNewIntentListener(&listener);
+  }
+}
+
 bool is_working_copy(const QString& path) {
   return !document_uri_for(path).isEmpty();
 }
