+#ifdef Q_OS_ANDROID
+void wrap_dialog_in_chrome_for_android(QDialog& dialog) {
+  if (dialog.property("patchy.androidChrome").toBool()) {
+    return;
+  }
+  dialog.setProperty("patchy.androidChrome", true);
+  if (dialog.findChild<QWidget*>(QStringLiteral("dialogChromeTitleBar"), Qt::FindDirectChildrenOnly) != nullptr) {
+    return;  // Already Patchy's own chrome.
+  }
+  QLayout* layout = dialog.layout();
+  if (layout == nullptr) {
+    return;
+  }
+  // Android draws no frame around an app's own windows. Move the dialog's layout
+  // (and the widgets it manages) into a body under the same title bar Patchy's
+  // frameless dialogs have; the window flags stay as they are, since changing
+  // them while the dialog is being shown would hide it again.
+  auto* body = new QWidget(&dialog);
+  body->setObjectName(QStringLiteral("dialogChromeContent"));
+  body->setLayout(layout);
+  auto* root = new QVBoxLayout(&dialog);
+  root->setContentsMargins(1, 1, 1, 1);
+  root->setSpacing(0);
+  append_themed_style(dialog, dialog_chrome_style());
+  root->addWidget(build_dialog_chrome_title_bar(dialog, dialog.windowTitle(), DialogChromeCloseMode::Reject));
+  root->addWidget(body, 1);
+}
+#endif
