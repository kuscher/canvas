+// Android draws no frame around an app's own windows, so every dialog without
+// Patchy's chrome gets its title bar as it is first polished. Message boxes and
+// Qt's stock dialogs manage their own layouts and are left alone.
+class AndroidDialogFrames final : public QObject {
+ protected:
+  bool eventFilter(QObject* watched, QEvent* event) override {
+    if (event->type() == QEvent::Polish) {
+      auto* dialog = qobject_cast<QDialog*>(watched);
+      if (dialog != nullptr && dialog->isWindow() && qobject_cast<QMessageBox*>(dialog) == nullptr &&
+          qobject_cast<QFileDialog*>(dialog) == nullptr && qobject_cast<QColorDialog*>(dialog) == nullptr &&
+          qobject_cast<QFontDialog*>(dialog) == nullptr && qobject_cast<QInputDialog*>(dialog) == nullptr &&
+          qobject_cast<QProgressDialog*>(dialog) == nullptr && qobject_cast<QErrorMessage*>(dialog) == nullptr &&
+          qobject_cast<QWizard*>(dialog) == nullptr) {
+        patchy::ui::wrap_dialog_in_chrome_for_android(*dialog);
+      }
+    }
+    return false;
+  }
+};
+#endif
+
 }  // namespace
 
