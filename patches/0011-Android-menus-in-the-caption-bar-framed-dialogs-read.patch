+// {height, left, right} of the caption bar, in device pixels.
+std::array<int, 3> caption_layout() {
+  std::array<int, 3> layout{0, 0, 0};
+  const auto values = QJniObject::callStaticObjectMethod("io/github/kuscher/canvas/CanvasActivity",
+                                                         "captionLayout", "()[I");
+  if (!values.isValid()) {
+    return layout;
+  }
+  QJniEnvironment env;
+  const auto array = static_cast<jintArray>(values.object());
+  if (env->GetArrayLength(array) >= 3) {
+    env->GetIntArrayRegion(array, 0, 3, layout.data());
+  }
+  return layout;
+}
+
+class CaptionMenuBar final : public QObject {
+ public:
+  explicit CaptionMenuBar(QMainWindow& window) : QObject(&window), window_(&window) {
+    window.setAttribute(Qt::WA_ContentsMarginsRespectsSafeArea, false);
+    window.installEventFilter(this);
+    // The caption is measured after Android lays the window out; check again shortly.
+    for (const int delay : {0, 300, 1000}) {
+      QTimer::singleShot(delay, this, [this] { update(); });
+    }
+  }
+
+ protected:
+  bool eventFilter(QObject* watched, QEvent* event) override {
+    if (watched == window_ &&
+        (event->type() == QEvent::Resize || event->type() == QEvent::Show ||
+         event->type() == QEvent::WindowStateChange)) {
+      QTimer::singleShot(0, this, [this] { update(); });
+      QTimer::singleShot(400, this, [this] { update(); });
+    }
+    return QObject::eventFilter(watched, event);
+  }
+
+ private:
+  void update() {
+    if (window_ == nullptr) {
+      return;
+    }
+    auto* bar = window_->menuBar();
+    const auto [height, left, right] = caption_layout();
+    const double ratio = window_->devicePixelRatio();
+    QString style;
+    if (height > 0 && ratio > 0.0) {
+      const int h = static_cast<int>(std::lround(height / ratio));
+      // A little air after the app menu, and before the window buttons.
+      const int l = static_cast<int>(std::lround(left / ratio)) + 6;
+      const int r = static_cast<int>(std::lround(right / ratio)) + 6;
+      style = QStringLiteral("QMenuBar { min-height: %1px; max-height: %1px; padding-left: %2px;"
+                             " padding-right: %3px; } QMenuBar::item { min-height: %1px; }")
+                  .arg(h)
+                  .arg(l)
+                  .arg(r);
+    }
+    if (style != applied_) {
+      applied_ = style;
+      bar->setStyleSheet(style);
+    }
+  }
+
+  QPointer<QMainWindow> window_;
+  QString applied_;
+};
+
 }  // namespace
 
+void put_menu_bar_in_caption(QMainWindow& window) {
+  new CaptionMenuBar(window);
+}
