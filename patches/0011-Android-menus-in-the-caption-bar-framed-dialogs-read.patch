+QString document_location(const QString& path) {
+  if (!is_working_copy(path)) {
+    return {};
+  }
+  QFile where(QFileInfo(path).absoluteDir().filePath(QString::fromLatin1(kLocationFile)));
+  return where.open(QIODevice::ReadOnly) ? QString::fromUtf8(where.readAll()).trimmed() : QString();
+}
+
+QString display_path(const QString& path) {
+  if (!is_working_copy(path)) {
+    return QDir::toNativeSeparators(path);
+  }
+  const auto location = document_location(path);
+  const auto name = QFileInfo(path).fileName();
+  return location.isEmpty() ? name : location + QStringLiteral(" \u203a ") + name;
+}
+
 bool is_working_copy(const QString& path) {
