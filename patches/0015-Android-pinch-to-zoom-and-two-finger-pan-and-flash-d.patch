+// Window pixels from Java to a logical point on the main window's screen.
+QPointF logical_point(float x, float y) {
+  const QWidget* window = QApplication::activeWindow();
+  const double ratio = window != nullptr ? window->devicePixelRatio() : qApp->devicePixelRatio();
+  return ratio > 0.0 ? QPointF(x / ratio, y / ratio) : QPointF(x, y);
+}
+
+QWidget* widget_under(const QPointF& point) {
+  auto* widget = QApplication::widgetAt(point.toPoint());
+  return widget;
+}
+
+void deliver_zoom(float x, float y, float factor) {
+  const auto global = logical_point(x, y);
+  for (auto* widget = widget_under(global); widget != nullptr; widget = widget->parentWidget()) {
+    const auto local = widget->mapFromGlobal(global);
+    QNativeGestureEvent event(Qt::ZoomNativeGesture, QPointingDevice::primaryPointingDevice(), 2, local, local,
+                              global, factor - 1.0, QPointF());
+    event.setAccepted(false);
+    QCoreApplication::sendEvent(widget, &event);
+    if (event.isAccepted()) {
+      return;
+    }
+    if (widget->isWindow()) {
+      return;
+    }
+  }
+}
+
+void deliver_pan(float x, float y, float dx, float dy) {
+  const auto global = logical_point(x, y);
+  auto* widget = widget_under(global);
+  if (widget == nullptr) {
+    return;
+  }
+  const auto delta = logical_point(dx, dy).toPoint();
+  QWheelEvent event(widget->mapFromGlobal(global), global, delta, delta * 2, Qt::NoButton, Qt::NoModifier,
+                    Qt::ScrollUpdate, false, Qt::MouseEventSynthesizedByApplication);
+  QCoreApplication::sendEvent(widget, &event);
+}
+
+void JNICALL java_zoom(JNIEnv*, jclass, jfloat x, jfloat y, jfloat factor) {
+  QMetaObject::invokeMethod(qApp, [x, y, factor] { deliver_zoom(x, y, factor); }, Qt::QueuedConnection);
+}
+
+void JNICALL java_pan(JNIEnv*, jclass, jfloat x, jfloat y, jfloat dx, jfloat dy) {
+  QMetaObject::invokeMethod(qApp, [x, y, dx, dy] { deliver_pan(x, y, dx, dy); }, Qt::QueuedConnection);
+}
+
 }  // namespace
 
+void route_gestures_to_widgets() {
+  const JNINativeMethod methods[] = {
+      {"nativeZoom", "(FFF)V", reinterpret_cast<void*>(java_zoom)},
+      {"nativePan", "(FFFF)V", reinterpret_cast<void*>(java_pan)},
+  };
+  QJniEnvironment env;
+  if (!env.registerNativeMethods("io/github/kuscher/canvas/CanvasGestures", methods, 2)) {
+    qWarning("Canvas: could not register the gesture callbacks");
+  }
+}
